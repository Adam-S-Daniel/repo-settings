#!/usr/bin/env bash
# agent-checks: the fleet's commit-time rules, run by local git hooks and by CI.
#
# Locally it runs from config-based git hooks (Git 2.54+) that
# adam-agentskills' scripts/install-agent-hooks.sh installs once per machine.
# CI runs the same file over a pull request's commits, and CI is the
# enforcement: a hook can be skipped with --no-verify, a required check
# cannot. See adam-agentskills ADR 0020 and _agent-guidance ADR 0021.
#
# Managed by _agent-guidance (templates/agent-checks/). The sync overwrites
# this file in every fleet repo, so change it there, not here.
#
# Usage:
#   agent-checks pre-commit
#   agent-checks pre-push <remote> <url>     (git's ref lines on stdin)
#   agent-checks ci <base> <head>
#   agent-checks tree [<rev>]                (every path in <rev>, default HEAD)
#
# `tree` is for measuring a check against a repo's whole current tree, so a new
# check can be shown to refuse nothing already on a fleet repo's main.
#
# Any other event exits 0, so a machine whose installer registers an event
# before this repo's copy of the runner knows it never blocks a commit.
#
# A repo adds checks of its own in .agent-checks/local.sh (see
# run_local_checks below), outside .githooks/ because this file is overwritten.
#
# Each refusal says what is wrong, why, and how to fix it. That message is the
# rule's documentation: an agent learns it when it breaks it, so the rule does
# not need to sit in always-on guidance.
#
# After the refusing checks, every event but an unknown one runs one WARNING
# pass, dated-phrasing (.githooks/dated-phrasing.js; see "Warning pass" below):
# dated history and migration-relative phrasing in the Markdown agents load as
# instructions. It prints `agent-checks (warning):` lines, or `::warning`
# annotations in CI, and never changes the exit status. To keep a flagged line
# that is right as written, add it to .agent-checks/dated-phrasing-allowlist.txt.
#
# Run log. Each pre-commit and pre-push run (never ci or tree) appends one JSON
# line to $AGENT_CHECKS_LOG, by default
# ${XDG_STATE_HOME:-$HOME/.local/state}/agent-checks/runs.jsonl, so a dashboard
# can show how often each check runs and refuses, per repo, over time:
#   {"v":1,"ts":"2026-10-26T12:00:00Z","event":"pre-commit","repo":"owner/name",
#    "checks":["rules-dir","secret-file","skill-shell"],"failed":["secret-file"],
#    "runner":"0123456789ab"}
# `repo` is origin's GitHub owner/name, or null for any other remote. `checks`
# are the ids of the checks that ran (dated-phrasing only when it read a file),
# `failed` the ones that refused; a warning is never in `failed`. `runner` is
# the first 12 hex digits of this file's own sha256, so a count can tell which
# version of the runner a repo had, or null when no hash tool is found. The line
# holds no paths, messages, branch names or user names. AGENT_CHECKS_LOG=off
# turns it off. Logging is best effort: a failure is silent and never changes
# the exit code or the output.
set -u

failed=0
# The ids of the checks that ran and of those that refused, space-separated,
# each once, in order. An id is a fixed kebab-case literal.
ran_ids=""
failed_ids=""

# note_ran <id> — record that the check <id> ran.
note_ran() {
  case "$1" in ''|*[!a-z0-9-]*) return 0 ;; esac
  case " $ran_ids " in *" $1 "*) ;; *) ran_ids="$ran_ids $1" ;; esac
}

# problem <id> <message> — refuse: print the message, record the check's id.
problem() {
  local id=$1
  shift
  printf 'agent-checks: %s\n' "$*" >&2
  failed=1
  note_ran "$id"
  case "$id" in ''|*[!a-z0-9-]*) return 0 ;; esac
  case " $failed_ids " in *" $id "*) ;; *) failed_ids="$failed_ids $id" ;; esac
}

# Which commit's content the checks read: "index" for pre-commit, else the
# revision being checked (pre-push: the pushed ref's commit; ci: the head;
# tree: the revision named). Set by each event before it calls check_paths.
content_rev=index

# file_content <path> — print the blob for <path> in the content being
# checked. Prints nothing, and succeeds, when that content has no such blob.
file_content() {
  local spec
  if [ "$content_rev" = index ]; then
    spec=":$1"
  else
    spec="$content_rev:$1"
  fi
  git cat-file -e "$spec" 2>/dev/null || return 0
  git cat-file blob "$spec"
}

# ── Lesson checks ────────────────────────────────────────────────────────────
# check_lessons <path> — called once for every path check_paths sees.
#
# The lesson-check lane (the fleet worker, _agent-guidance ADR 0027) adds
# `case` arms here, one per lesson an agent learned, each with a refusal
# through `problem` that says what is wrong, why, and how to fix it, and a
# trailing `# lesson: <id>` comment. Read a file's content with file_content.
# A refusal names the path and the rule only; it never prints file content,
# which could be a secret.
#
# Each arm refuses with `problem lesson-<id> "..."`, and lists that same
# check id in lesson_checks, so the run log counts the check as run.
lesson_checks=""

check_lessons() {
  :
}

# Reads NUL-separated paths on stdin and refuses the ones that must never be
# committed.
check_paths() {
  local path
  while IFS= read -r -d '' path; do
    [ -n "$path" ] || continue
    case "$path" in
      .claude/rules/*)
        problem rules-dir "$path: path-scoped rules (.claude/rules/) are not used in this fleet. Only Claude Code reads them. Put the rule in AGENTS.md or a skill, or make it a check in .githooks/agent-checks." ;;
    esac
    case "${path##*/}" in
      .env.example|.env.sample|.env.template) ;;
      .env|.env.*|*.pem|*.key|*.p12|*.pfx|id_rsa|id_ecdsa|id_ed25519)
        problem secret-file "$path: looks like a secret or credential file, and git history in a public repo is public. Unstage it (git restore --staged -- '$path') and add it to .gitignore." ;;
    esac
    # A skill or command file that runs a shell command when it loads.
    is_skill_file=false
    case "${path##*/}" in SKILL.md) is_skill_file=true ;; esac
    case "$path" in
      .claude/commands/*.md|*/.claude/commands/*.md|plugins/*/commands/*.md) is_skill_file=true ;;
    esac
    # A here-string, not a pipe: grep -q exits at the first match, which can
    # kill a writer still filling the pipe.
    if $is_skill_file \
        && grep -Eq '(^|[[:space:]])!`|^[[:space:]]*```!' <<<"$(file_content "$path")"; then
      problem skill-shell "$path: a line starts a shell command that Claude Code runs when the skill loads (an exclamation mark then a backtick, at line start or after a space, or a code fence opened with a backtick fence and an exclamation mark). It runs before the model reads the skill, so no review and no prompt-injection defense sees it. Have the skill tell the agent to run the command, or move the command into a script the skill calls."
    fi
    check_lessons "$path" < /dev/null
  done
}

# ── Repo-local checks ────────────────────────────────────────────────────────
# A repo's own rules live in .agent-checks/local.sh, which the sync never
# touches. After the fleet checks, the runner starts it as a separate process,
# `bash .agent-checks/local.sh <event>`, with the same NUL-separated path list
# on stdin and AGENT_CHECKS_REV set to the commit being checked (empty for the
# index), so it can read content with `git show "$AGENT_CHECKS_REV:<path>"`
# (`git show ":<path>"` when empty). Its stderr passes through; a nonzero exit
# refuses. It is a child, not sourced, so it can only add refusals: it cannot
# skip, change or clear a fleet check. A symlink is not run.
#
# How to add one: commit .agent-checks/local.sh with LF line endings (add
# `.agent-checks/* text eol=lf` to .gitattributes; bash fails on CRLF). Exit 0
# to allow, nonzero to refuse, after printing on stderr what is wrong, why and
# how to fix it; name the path, never print file content. Every event runs it,
# so test it with `bash .githooks/agent-checks tree`. Example:
#
#   status=0
#   while IFS= read -r -d '' path; do
#     case "$path" in *.draft) echo "agent-checks (local): $path: drafts stay out of this repo. Move it to your notes." >&2; status=1 ;; esac
#   done
#   exit $status
local_checks=.agent-checks/local.sh

run_local_checks() {
  local top rev rc=0
  top=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  [ -f "$top/$local_checks" ] && [ ! -L "$top/$local_checks" ] || return 0
  note_ran repo-local
  rev=$content_rev
  [ "$rev" = index ] && rev=""
  (cd "$top" && AGENT_CHECKS_REV=$rev bash "$local_checks" "$event") || rc=$?
  if [ "$rc" -ne 0 ]; then
    problem repo-local "$local_checks (this repo's own checks) refused, exit $rc; its messages are above. Fix the cause, or fix the check in $local_checks if it is wrong."
  fi
}

# ── Warning pass: dated phrasing ─────────────────────────────────────────────
# .githooks/dated-phrasing.js warns about dated history and migration-relative
# phrasing ("is now", "no longer", "moved to", an ISO date) in the Markdown
# agents load as instructions: every AGENTS.md (its repo-specific half),
# CLAUDE.md and SKILL.md, and agents-md/**. That text is read as the rule that
# holds now, so a story about what changed, and when, goes stale there; it
# belongs in docs/evidence/ or git (_agent-guidance#348). Its header lists the
# phrases and the exemptions (code, quotes, HTML, URLs, link text).
#
# It only ever warns: it runs after the refusing checks, its output never
# changes the exit status, and any failure of its own (no node or npm, an
# offline install, an internal error) prints one warning line and moves on
# (_agent-guidance ADR 0017: checks that grow out of the prompt audit warn).
# Each warning line starts `agent-checks (warning):`, or is a `::warning`
# annotation under GitHub Actions; it names the path, line and phrase only.
#
# It needs markdown-it (a real Markdown parse, never a line scan). The runner
# installs the exact version .githooks/dated-phrasing/package-lock.json pins,
# with `npm ci --ignore-scripts`, into a cache keyed by the lockfile's sha256,
# ${XDG_CACHE_HOME:-$HOME/.cache}/agent-checks/dated-phrasing/<sha256> (under
# $RUNNER_TEMP in CI), and reuses it after that. Nothing is installed when no
# path in scope changed.
#
# To keep text that is right as written (a present-tense fact that uses a
# listed phrase, a date that qualifies a measurement), add a line to this
# repo's .agent-checks/dated-phrasing-allowlist.txt, which the sync never
# touches:
#   owner/repo path/to/AGENTS.md :: a few words from the flagged sentence
# The entry silences the flagged paragraph, list item or heading whose source
# holds those words. The format is in .githooks/dated-phrasing-allowlist.txt,
# the fleet's own list, managed by _agent-guidance.
dated_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd) || dated_dir=""

# dated_warn <message> — one warning line, never a refusal. On stderr in both
# forms (GitHub reads annotations from either stream), so a caller's command
# substitution never captures it.
dated_warn() {
  if [ "${GITHUB_ACTIONS:-}" = true ]; then
    printf '::warning title=dated-phrasing::%s\n' "$1" >&2
  else
    printf 'agent-checks (warning): %s\n' "$1" >&2
  fi
}

# dated_modules — print the node_modules directory that holds markdown-it,
# installing it on first use; on failure warn once and return 1.
# AGENT_CHECKS_DATED_PHRASING_MODULES names a directory to use instead, for
# the tests, which must not reach the network.
dated_modules() {
  local pkg=$dated_dir/dated-phrasing base key dir tmp
  if [ -n "${AGENT_CHECKS_DATED_PHRASING_MODULES:-}" ]; then
    printf '%s\n' "$AGENT_CHECKS_DATED_PHRASING_MODULES"
    return 0
  fi
  if ! command -v npm > /dev/null 2>&1; then
    dated_warn "dated-phrasing skipped: npm is not on PATH, so markdown-it cannot be installed. Install Node.js to get these warnings locally; CI still runs them."
    return 1
  fi
  if [ "${GITHUB_ACTIONS:-}" = true ] && [ -n "${RUNNER_TEMP:-}" ]; then
    base=$RUNNER_TEMP
  elif [ -n "${XDG_CACHE_HOME:-}" ]; then
    base=$XDG_CACHE_HOME
  elif [ -n "${HOME:-}" ]; then
    base=$HOME/.cache
  else
    dated_warn "dated-phrasing skipped: neither XDG_CACHE_HOME nor HOME is set, so there is nowhere to install markdown-it."
    return 1
  fi
  key=$(node -e 'process.stdout.write(require("crypto").createHash("sha256").update(require("fs").readFileSync(process.argv[1])).digest("hex"))' \
        "$pkg/package-lock.json" 2> /dev/null) || key=""
  case "$key" in
    ''|*[!0-9a-f]*)
      dated_warn "dated-phrasing skipped: $pkg/package-lock.json is missing or unreadable."
      return 1 ;;
  esac
  dir=$base/agent-checks/dated-phrasing/$key
  if [ ! -f "$dir/node_modules/markdown-it/package.json" ]; then
    # Install beside the final directory and rename into place, so a run that
    # is interrupted, or races another, never leaves a half-installed cache.
    if ! { mkdir -p "$base/agent-checks/dated-phrasing" \
           && tmp=$(mktemp -d "$base/agent-checks/dated-phrasing/.install.XXXXXX") \
           && cp "$pkg/package.json" "$pkg/package-lock.json" "$tmp/" \
           && (cd "$tmp" && npm ci --ignore-scripts --no-audit --no-fund --loglevel=error) > /dev/null 2>&1; }; then
      [ -n "${tmp:-}" ] && rm -rf "$tmp"
      dated_warn "dated-phrasing skipped: installing markdown-it with npm ci failed (offline, or no access to the npm registry). It retries on the next run."
      return 1
    fi
    [ -f "$dir/node_modules/markdown-it/package.json" ] || { rm -rf "$dir"; mv "$tmp" "$dir" 2> /dev/null; }
    rm -rf "$tmp"
    if [ ! -f "$dir/node_modules/markdown-it/package.json" ]; then
      dated_warn "dated-phrasing skipped: markdown-it was installed but could not be moved into $dir."
      return 1
    fi
  fi
  printf '%s\n' "$dir/node_modules"
}

# run_dated_phrasing <list> — the warning pass over a NUL-separated path list.
# It is counted in the run log (note_ran) only when it read a file.
run_dated_phrasing() {
  local list=$1 top rev count mods rc=0
  top=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  [ -n "$dated_dir" ] && [ -f "$dated_dir/dated-phrasing.js" ] || return 0
  if ! command -v node > /dev/null 2>&1; then
    # Silent unless a path in scope changed, which needs no node to tell.
    count=$(tr '\0' '\n' < "$list" | grep -vE '^evals/.*/seed/' \
            | grep -cE '(^|/)(AGENTS|CLAUDE|SKILL)\.md$|^agents-md/.*\.md$') || count=0
    [ "$count" -gt 0 ] && dated_warn "dated-phrasing skipped: node is not on PATH. Install Node.js to get these warnings locally; CI still runs them."
    return 0
  fi
  count=$(cd "$top" && node "$dated_dir/dated-phrasing.js" --count-scope < "$list" 2> /dev/null) || count=""
  case "$count" in
    ''|*[!0-9]*) dated_warn "dated-phrasing skipped: it could not read the path list."; return 0 ;;
    0) return 0 ;;
  esac
  mods=$(dated_modules) || return 0
  note_ran dated-phrasing
  rev=$content_rev
  (cd "$top" && node "$dated_dir/dated-phrasing.js" --rev "$rev" --modules "$mods" < "$list") || rc=$?
  [ "$rc" -eq 0 ] || dated_warn "dated-phrasing stopped with exit $rc; its warnings may be incomplete."
  return 0
}

# run_checks — the fleet checks, then the repo's own, over the same
# NUL-separated path list on stdin, then the warning pass.
run_checks() {
  local list id
  note_ran rules-dir
  note_ran secret-file
  note_ran skill-shell
  for id in $lesson_checks; do note_ran "$id"; done
  list=$(mktemp) || { problem runner-error "could not create a temp file, so nothing was checked."; return; }
  cat > "$list"
  check_paths < "$list"
  run_local_checks < "$list"
  run_dated_phrasing "$list"
  rm -f "$list"
}

# Paths added or changed by any commit in a range, so a file added and then
# deleted inside the range is still caught: it stays in the history.
paths_in_range() {
  git log --format= --name-only -z --diff-filter=ACMR "$@"
}

default_branch() {
  local remote=$1 head
  head=$(git symbolic-ref --quiet --short "refs/remotes/$remote/HEAD" 2>/dev/null) || head=""
  if [ -n "$head" ]; then
    printf '%s\n' "${head#"$remote"/}"
  else
    printf '%s\n' main master
  fi
}

# git writes an all-zero object id for "no commit" (a new branch, a delete),
# 40 digits under SHA-1 and 64 under SHA-256.
is_zero() {
  case "$1" in
    ''|*[!0]*) return 1 ;;
  esac
}

# Usable as a range base: a real commit this clone has.
known_commit() {
  [ -n "$1" ] && ! is_zero "$1" && git cat-file -e "$1^{commit}" 2>/dev/null
}

event=${1:-}
case "$event" in
  pre-commit)
    content_rev=index
    run_checks < <(git diff --cached --name-only -z --diff-filter=ACMR)
    ;;

  pre-push)
    remote=${2:-origin}
    note_ran staged-index
    note_ran push-to-default
    note_ran persistent-delete
    if ! git diff --cached --quiet; then
      problem staged-index "the index has staged changes that are in no commit. If your last 'git commit' was refused by a hook, this push would publish the commit before it and report success. Commit or unstage them first (git status), then push."
    fi
    defaults=$(default_branch "$remote")
    while read -r _ local_oid remote_ref remote_oid; do
      [ -n "${remote_ref:-}" ] || continue
      for branch in $defaults; do
        if [ "$remote_ref" = "refs/heads/$branch" ]; then
          problem push-to-default "refusing to push to $branch: fleet default branches take changes only through pull requests, and GitHub would reject it (GH013). Push a feature branch and open a PR."
        fi
      done
      if is_zero "$local_oid"; then
        case "$remote_ref" in
          refs/heads/persistent/*)
            problem persistent-delete "refusing to delete ${remote_ref#refs/heads/}: persistent/* branches outlive their PRs and hold data (results, usage records), and deleting one loses it. Private repos without rulesets have nothing else to stop this. If it really must go, ask Adam." ;;
        esac
        continue
      fi
      content_rev=$local_oid
      if known_commit "$remote_oid"; then
        run_checks < <(paths_in_range "$remote_oid..$local_oid")
      else
        run_checks < <(paths_in_range "$local_oid" --not --remotes="$remote")
      fi
    done
    ;;

  ci)
    base=${2:-}
    head=${3:-HEAD}
    content_rev=$head
    if known_commit "$base"; then
      run_checks < <(paths_in_range "$base..$head")
    else
      run_checks < <(paths_in_range -1 "$head")
    fi
    ;;

  tree)
    rev=${2:-HEAD}
    if ! git rev-parse --verify --quiet "$rev^{tree}" > /dev/null; then
      problem tree-rev "tree: '$rev' is not a commit or tree in this repository, so nothing was checked. Name a revision that exists (git rev-parse --verify '$rev')."
    else
      content_rev=$rev
      run_checks < <(git ls-tree -r -z --name-only "$rev")
    fi
    ;;

  *)
    exit 0
    ;;
esac

# ── Run log ──────────────────────────────────────────────────────────────────
# json_ids <ids> — a JSON array of space-separated kebab-case ids.
json_ids() {
  local id out=""
  for id in $1; do out="$out${out:+,}\"$id\""; done
  printf '[%s]' "$out"
}

# origin_repo — origin's GitHub "owner/name" as a JSON string, or null.
origin_repo() {
  local url rest owner name ok=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-
  url=$(git remote get-url origin 2>/dev/null) || url=""
  case "$url" in
    https://github.com/*) rest=${url#https://github.com/} ;;
    git@github.com:*) rest=${url#git@github.com:} ;;
    ssh://git@github.com/*) rest=${url#ssh://git@github.com/} ;;
    *) rest="" ;;
  esac
  rest=${rest%.git}
  owner=${rest%%/*}
  name=${rest#*/}
  case "$owner" in ''|*[!$ok]*) printf null; return ;; esac
  case "$name" in ''|*[!$ok]*) printf null; return ;; esac
  printf '"%s/%s"' "$owner" "$name"
}

# runner_digest — this file's sha256, first 12 hex digits, as a JSON string,
# or null when no hash tool answers.
runner_digest() {
  local self=${BASH_SOURCE[0]} sum
  sum=$( { sha256sum -- "$self" || shasum -a 256 -- "$self"; } 2>/dev/null) || sum=""
  sum=${sum%% *}
  sum=${sum:0:12}
  case "$sum" in
    [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) printf '"%s"' "$sum" ;;
    *) printf null ;;
  esac
}

log_run() {
  local log=${AGENT_CHECKS_LOG:-} base ts line
  [ "$log" = off ] && return 0
  if [ -z "$log" ]; then
    base=${XDG_STATE_HOME:-}
    [ -n "$base" ] || { [ -n "${HOME:-}" ] && base=$HOME/.local/state; } || return 0
    log=$base/agent-checks/runs.jsonl
  fi
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null) || return 0
  line=$(printf '{"v":1,"ts":"%s","event":"%s","repo":%s,"checks":%s,"failed":%s,"runner":%s}' \
    "$ts" "$event" "$(origin_repo)" "$(json_ids "$ran_ids")" "$(json_ids "$failed_ids")" "$(runner_digest)")
  (
    mkdir -p -- "$(dirname -- "$log")" || exit 0
    { [ ! -e "$log" ] || [ -f "$log" ]; } || exit 0
    printf '%s\n' "$line" >> "$log"
  ) > /dev/null 2>&1 || true
}

case "$event" in
  pre-commit|pre-push) log_run ;;
esac

if [ "$failed" -ne 0 ]; then
  printf '%s\n' "agent-checks: fix the cause rather than skipping the hook (--no-verify); CI runs the same checks. If a check is wrong, say so to Adam." >&2
  exit 1
fi
exit 0
